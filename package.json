{
  "name": "g4ever",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @g4ever/web",
    "dev:api": "npm run dev -w @g4ever/api",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:yanis": "tsx --test tests/yanis-campaign.test.ts",
    "test:yanis:ui": "playwright test --config playwright.yanis.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
