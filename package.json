{
  "name": "g4ever",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @g4ever/web",
    "dev:api": "npm run dev -w @g4ever/api",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:valentin": "node --experimental-strip-types --test tests/valentin-session.test.mjs",
    "test:valentin:ui": "playwright test --config playwright.valentin.config.mjs",
    "test:jeu": "playwright test --config playwright.jeu.config.mjs",
    "test": "npm run test:jeu",
    "dev:all": "node scripts/dev.mjs",
    "dev:race": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "start:race": "tsx server/index.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "test:robin": "tsx --test tests/robin-world.test.ts",
    "test:robin:ui": "playwright test --config playwright.robin.config.mjs",
    "test:yanis": "tsx --test tests/yanis-campaign.test.ts",
    "test:yanis:ui": "playwright test --config playwright.yanis.config.mjs",
    "test:integration": "playwright test --config playwright.integration.config.mjs",
    "test:regles": "npm run test:valentin && npm run test:robin && npm run test:yanis"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
